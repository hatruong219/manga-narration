# Chép file này thành .env rồi điền giá trị. .env đã bị .gitignore, không lên repo.
#   cp .env.example .env

# Bắt buộc — lấy ở studio.vbee.vn/apps → Tích hợp API → Tạo ứng dụng
VBEE_TOKEN=
VBEE_APP_ID=

# Tuỳ chọn
VBEE_VOICE=hn_female_ngochuyen_full_48k-fhg
VBEE_SPEED=1.0
VBEE_BITRATE=128
# VBEE_CALLBACK=https://...     # chỉ khi có webhook công khai
# VBEE_TIMEOUT=180
